{
  "schema_version": "dof.openrouter-e0-profile.v1",
  "provider": "openrouter",
  "adapter_type": "openrouter_chat_completions",
  "adapter_version": "dof.openrouter-chat-completions.v1",
  "base_url": "https://openrouter.ai/api/v1",
  "endpoint": "/chat/completions",
  "models_endpoint": "/models",
  "api_key_env": "OPENROUTER_API_KEY",
  "models": [
    "openai/gpt-5.6-luna",
    "anthropic/claude-sonnet-5"
  ],
  "stream": false,
  "max_tokens": 1024,
  "application_retries": 0,
  "transport_retries": 0,
  "repair_requests": 0,
  "response_format": {
    "type": "json_object"
  },
  "provider_routing": {
    "allow_fallbacks": false,
    "require_parameters": true,
    "data_collection": "deny"
  },
  "headers": {
    "X-OpenRouter-Metadata": "enabled",
    "X-OpenRouter-Cache": "false"
  },
  "plugins": [
    {
      "id": "response-healing",
      "enabled": false
    },
    {
      "id": "context-compression",
      "enabled": false
    }
  ]
}
